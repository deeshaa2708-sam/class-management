generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  INSTITUTE_ADMIN
  TEACHER
  STUDENT
}

enum Shift {
  MORNING
  AFTERNOON
  EVENING
}

enum Day {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum NotificationStatus {
  SENT
  FAILED
  PENDING
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  AUTO_RESOLVED
}

enum RequestType {
  ABSENCE
  EXTRA_LECTURE
}

// ─── Institute ────────────────────────────────────────────────────────────────

model Institute {
  id                    String   @id @default(cuid())
  name                  String
  logoUrl               String?
  whatsappTemplate      String   @default("Your student {student_name} was absent for the {subject} class on {date}.")
  timezone              String   @default("Asia/Kolkata")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  branches    Branch[]
  users       User[]
  subjects    Subject[]
  classes     Class[]
  teachers    Teacher[]
  students    Student[]
  notifLogs   NotificationLog[]
}

model Branch {
  id          String   @id @default(cuid())
  name        String
  address     String?
  instituteId String
  createdAt   DateTime @default(now())

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  classes   Class[]
}

// ─── Auth / User ──────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role
  name         String
  phone        String?
  instituteId  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  institute Institute? @relation(fields: [instituteId], references: [id])
  teacher   Teacher?
  student   Student?

  @@index([email])
  @@index([instituteId])
}

// ─── Academic Entities ────────────────────────────────────────────────────────

model Subject {
  id          String @id @default(cuid())
  name        String
  code        String
  color       String @default("#6366f1") // color-coded in timetable
  instituteId String

  institute       Institute        @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  classSubjects   ClassSubject[]
  teacherSubjects TeacherSubject[]
  lectures        Lecture[]
  materials       Material[]
  attendances     AttendanceRecord[]

  @@unique([code, instituteId])
}

model Class {
  id              String @id @default(cuid())
  name            String
  shift           Shift
  lectureDuration Int    @default(50) // minutes
  instituteId     String
  branchId        String?
  createdAt       DateTime @default(now())

  institute    Institute      @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branch       Branch?        @relation(fields: [branchId], references: [id])
  classSubjects ClassSubject[]
  students     Student[]
  timetables   Timetable[]

  @@index([instituteId])
}

model ClassSubject {
  id               String @id @default(cuid())
  classId          String
  subjectId        String
  lecturesPerWeek  Int    @default(3)

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([classId, subjectId])
}

// ─── Teacher ──────────────────────────────────────────────────────────────────

model Teacher {
  id          String @id @default(cuid())
  userId      String @unique
  employeeId  String?
  instituteId String
  createdAt   DateTime @default(now())

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  institute       Institute         @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  teacherSubjects TeacherSubject[]
  availability    TeacherAvailability[]
  lectures        Lecture[]
  changeRequests  ChangeRequest[]

  @@index([instituteId])
}

model TeacherSubject {
  id               String @id @default(cuid())
  teacherId        String
  subjectId        String
  classId          String
  lecturesRequired Int    @default(3) // required per week for this class

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId, classId])
}

model TeacherAvailability {
  id        String  @id @default(cuid())
  teacherId String
  day       Day
  startTime String  // "09:00"
  endTime   String  // "13:00"

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, day, startTime])
}

// ─── Student ──────────────────────────────────────────────────────────────────

model Student {
  id                String @id @default(cuid())
  userId            String @unique
  classId           String
  rollNumber        String?
  parentWhatsapp    String?   // E.164 format e.g. +919876543210
  instituteId       String
  createdAt         DateTime @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  class       Class     @relation(fields: [classId], references: [id])
  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  attendances AttendanceRecord[]
  events      PersonalEvent[]

  @@index([instituteId])
  @@index([classId])
}

model PersonalEvent {
  id          String   @id @default(cuid())
  studentId   String
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  hasConflict Boolean  @default(false)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

// ─── Timetable / Schedule ─────────────────────────────────────────────────────

model Timetable {
  id          String   @id @default(cuid())
  classId     String
  weekStart   DateTime // ISO Monday of that week
  generatedAt DateTime @default(now())
  isActive    Boolean  @default(true)

  class    Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  lectures Lecture[]

  @@index([classId, weekStart])
}

model Lecture {
  id          String   @id @default(cuid())
  timetableId String
  subjectId   String
  teacherId   String
  day         Day
  startTime   String   // "09:00"
  endTime     String   // "09:50"
  isCancelled Boolean  @default(false)
  substituteId String? // another teacher filling in
  createdAt   DateTime @default(now())

  timetable   Timetable @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  subject     Subject   @relation(fields: [subjectId], references: [id])
  teacher     Teacher   @relation(fields: [teacherId], references: [id])
  attendances AttendanceRecord[]
}

model ChangeRequest {
  id          String        @id @default(cuid())
  teacherId   String
  type        RequestType
  status      RequestStatus @default(PENDING)
  date        DateTime
  reason      String?
  resolvedAt  DateTime?
  createdAt   DateTime      @default(now())

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

// ─── Attendance ───────────────────────────────────────────────────────────────

model AttendanceRecord {
  id        String   @id @default(cuid())
  studentId String
  lectureId String
  subjectId String
  date      DateTime
  present   Boolean

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lecture Lecture @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id])

  @@unique([studentId, lectureId])
}

model NotificationLog {
  id          String             @id @default(cuid())
  instituteId String
  studentName String
  parentPhone String
  subject     String
  date        DateTime
  status      NotificationStatus @default(PENDING)
  errorMsg    String?
  sentAt      DateTime?
  createdAt   DateTime           @default(now())

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@index([instituteId, createdAt])
}

// ─── Study Material ───────────────────────────────────────────────────────────

model Material {
  id          String   @id @default(cuid())
  title       String
  description String?
  fileUrl     String
  fileType    String
  subjectId   String
  uploadedBy  String   // teacherId
  instituteId String
  classIds    String[] // which classes can see it
  createdAt   DateTime @default(now())

  subject Subject @relation(fields: [subjectId], references: [id])
}
